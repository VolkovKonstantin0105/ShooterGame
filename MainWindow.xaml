<Window x:Class="SGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShooterGame" Height="420" Width="640"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#1E2B1E">

    <Window.Resources>

        <!-- Пиксельная кнопка -->
        <Style x:Key="PixelButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF3D6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <!-- тень -->
                            <Border Background="#1A0F08" Margin="0,4,0,0"/>
                            <!-- внешняя рамка -->
                            <Border x:Name="Outer" Background="#2B1A0E"
                                    BorderBrush="#1A0F08" BorderThickness="3"
                                    Margin="0,0,0,4">
                                <!-- внутренняя подсветка -->
                                <Border x:Name="Inner" Background="#8A5A2B"
                                        BorderBrush="#C98B45" BorderThickness="2,2,0,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#A8702F"/>
                                <Setter TargetName="Inner" Property="BorderBrush" Value="#F0B565"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Margin" Value="0,4,0,0"/>
                                <Setter TargetName="Inner" Property="Background" Value="#6E4520"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Inner" Property="Background" Value="#555"/>
                                <Setter Property="Foreground" Value="#999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Зеленая кнопка для главного действия -->
        <Style x:Key="PixelButtonGreen" TargetType="Button" BasedOn="{StaticResource PixelButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="#0F2410" Margin="0,4,0,0"/>
                            <Border x:Name="Outer" Background="#0F2410"
                                    BorderBrush="#0F2410" BorderThickness="3" Margin="0,0,0,4">
                                <Border x:Name="Inner" Background="#3E8E41"
                                        BorderBrush="#7BD67E" BorderThickness="2,2,0,0">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Inner" Property="Background" Value="#4FAE53"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="Margin" Value="0,4,0,0"/>
                                <Setter TargetName="Inner" Property="Background" Value="#2D6E30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фон: NearestNeighbor, чтобы пиксели оставались четкими -->
       

        <!-- Легкое затемнение для читаемости -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0"/>
                    <GradientStop Color="#33000000" Offset="0.5"/>
                    <GradientStop Color="#AA000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Заголовок -->
        <TextBlock Text="SHOOTER GAME" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,25,0,0" FontFamily="Consolas" FontSize="44" FontWeight="ExtraBold"
                   Foreground="#FFD27A">
            <TextBlock.Effect>
                <DropShadowEffect Color="#1A0F08" ShadowDepth="4" Direction="315"
                                  BlurRadius="0" Opacity="1"/>
            </TextBlock.Effect>
        </TextBlock>

        <!-- Меню -->
        <Border Width="260" VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="0,60,0,0" Padding="20,14"
                Background="#B0140C06" BorderBrush="#1A0F08" BorderThickness="3">
            <StackPanel>
                <Button x:Name="StartGame" Content="ИГРАТЬ"
                        Style="{StaticResource PixelButtonGreen}" Click="StartGame_Click"/>
                <Button x:Name="ApiButton" Content="ОНЛАЙН (API)"
                        Style="{StaticResource PixelButton}" Click="ApiButton_Click"/>
                <Button x:Name="ExitButton" Content="ВЫХОД"
                        Style="{StaticResource PixelButton}" Click="ExitButton_Click"/>
            </StackPanel>
        </Border>

        <!-- Анимированный персонаж -->
        <Image x:Name="PriestImage" Width="64" Height="64"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,0,0,15"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
    </Grid>
</Window>